# ============================================================================
# exif-tagger configuration example
# ============================================================================

# Root directory to scan recursively for images.
# Can be overridden by env var EXIFTAGGER_ROOT_DIRECTORY.
root_directory: "/data/images"

# Vision model configuration (OpenAI-compatible endpoint)
model:
  base_url: "https://api.openai.com/v1"      # OpenAI or compatible (e.g., local Ollama, vLLM)
  model_name: "gpt-4o"                        # Model identifier
  api_key: ""                                 # Or set env var OPENAI_API_KEY
  max_tokens: 500                             # Max tokens per response
  temperature: 0.1                            # Low for deterministic output
  # params:                                   # Extra model parameters passed to the API
  #   top_p: 0.95                             # Nucleus sampling parameter
  #   response_format: {"type": "json_object"}# Force JSON-structured output

# Maximum image dimension (width or height) before resizing.
# Images larger than this will be proportionally scaled down using LANCZOS resampling.
# Range: 100–4096, default: 720. Can also be set via env var EXIFTAGGER_MAX_IMAGE_DIMENSION.
max_image_dimension: 720

# Global log level (DEBUG, INFO, WARNING, ERROR, CRITICAL) and directory for daily rotating log files.
# Can be overridden by env vars EXIFTAGGER_LOG_LEVEL and EXIFTAGGER_LOG_DIR.
log_level: "INFO"
log_dir: "/app/logs"

# Tag definitions – each tag has a description and threshold (0-1)
# Images scoring >= threshold will have the tag written to XPTags.
tags:
  landscape:
    description: "A scenic natural landscape with mountains, forests, water, or open vistas"
    threshold: 0.7

  portrait:
    description: "An image where a person's face is clearly visible and in focus"
    threshold: 0.8

  architecture:
    description: "Buildings, bridges, towers, or other constructed structures"
    threshold: 0.6

  wildlife:
    description: "Animals in natural habitat – birds, mammals, insects, fish"
    threshold: 0.7

  food:
    description: "Food items, meals, or culinary presentations"
    threshold: 0.8

  abstract:
    description: "Abstract art, patterns, textures without clear subject matter"
    threshold: 0.5

# Background gallery index poller — keeps the SQLite gallery index in sync with the
# filesystem without scanning the whole library on every request.
gallery_index:
  enabled: true
  poll_interval_seconds: 10   # 0 disables the poller

# Safety guardrails against model hallucination cascades and multi-tag overflow.
guardrails:
  enabled: true
  max_matched_tags: 2        # Maximum tags allowed to match for a single photo (typically 1 or 2)
  on_overflow: "suppress"    # Options: "suppress" (safest: write no EXIF tags), "top_k", or "warn"

# Regex patterns for file/directory paths to exclude from processing.
# Example: skip hidden directories and thumbnail folders.
exclude_patterns:
  - "^\\.DS_Store"
  - "/\\."
  - "thumbs?_?(db|cache)?/i?"
  - "\\.temp$"
